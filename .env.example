# Copy to .env and fill in. Do not commit .env.
# Empty values are ignored. A set owner password overrides the password file.

HERMES_BRIDGE_CONFIG=config.yaml
HERMES_BRIDGE_ISSUER=https://bridge.example.com
HERMES_BRIDGE_RESOURCE=https://bridge.example.com/mcp
HERMES_BRIDGE_BIND_HOST=127.0.0.1
HERMES_BRIDGE_BIND_PORT=8765
HERMES_BRIDGE_DATA_DIR=data
HERMES_BRIDGE_DEV_MODE=false
HERMES_BRIDGE_CONSENT_EXPOSURE=public
HERMES_BRIDGE_OWNER_PASSWORD=
HERMES_BRIDGE_OWNER_PASSWORD_FILE=secrets/owner_password
HERMES_BRIDGE_HERMES_BACKEND=http
HERMES_BRIDGE_HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_BRIDGE_HERMES_API_KEY=
HERMES_BRIDGE_HERMES_API_KEY_FILE=secrets/hermes_api_key
HERMES_BRIDGE_HERMES_ALLOW_NON_LOOPBACK=false
HERMES_BRIDGE_SYNC_ASK=false
HERMES_BRIDGE_PRIVATE_SCHEMES=cursor
HERMES_BRIDGE_ALLOWED_HOSTS=
