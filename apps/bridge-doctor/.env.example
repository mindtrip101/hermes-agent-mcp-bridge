# Copy to .env and fill in. Do not commit .env.
# hermes-bridge-doctor does not load this file. Export the variables first.

# Used by `check --online` when you want the doctor to log in and list tools.
# The bridge also accepts the owner password file from its own config.
HERMES_BRIDGE_OWNER_PASSWORD=
HERMES_BRIDGE_HERMES_API_KEY=

# Optional check-run publish. Leave DOCTOR_PUBLISH unset unless a CI job should post a result.
# github: GITHUB_TOKEN, GITHUB_REPOSITORY (owner/name), DOCTOR_HEAD_SHA
# origin: ORIGIN_INSTALLATION_TOKEN, ORIGIN_OWNER, ORIGIN_REPO, DOCTOR_HEAD_SHA
DOCTOR_PUBLISH=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_BASE=https://api.github.com
DOCTOR_HEAD_SHA=
ORIGIN_INSTALLATION_TOKEN=
ORIGIN_OWNER=
ORIGIN_REPO=
ORIGIN_API_BASE=https://api.cursor.com
