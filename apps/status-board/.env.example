# Copy to .env and fill in. Do not commit .env.
# The status page and the MCP tools run inside hermes-agent-mcp-bridge.
# This file is the connector-side view.

# Public MCP resource. HTTPS in any setup that is not loopback.
HERMES_BRIDGE_RESOURCE=https://bridge.example.com/mcp

# Optional. When set, GET /status and GET /status.json require this bearer.
# Send it as Authorization: Bearer. Do not put it in the query string.
HERMES_BRIDGE_STATUS_TOKEN=
