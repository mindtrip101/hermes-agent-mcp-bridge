# Copy to .env and fill in. Do not commit .env.
# The reviewer reads the process environment. It does not load this file by itself.

# Bridge. The resource defaults to BRIDGE_URL + /mcp.
HERMES_REVIEW_BRIDGE_URL=http://127.0.0.1:8765
HERMES_REVIEW_BRIDGE_RESOURCE=
HERMES_BRIDGE_OWNER_PASSWORD=

# Listener for forge webhooks. Keep it on loopback and put HTTPS in front.
HERMES_REVIEW_BIND_HOST=127.0.0.1
HERMES_REVIEW_BIND_PORT=8780
# true posts the review before the webhook response. Leave false in production.
HERMES_REVIEW_SYNC=false
HERMES_REVIEW_DRAFTS=false
HERMES_REVIEW_MAX_PROMPT_CHARS=7000
HERMES_REVIEW_TIMEOUT_SECONDS=90

# GitHub App or a token that can read the pull request diff and post a comment review.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_API_BASE=https://api.github.com

# Origin app. Register the public key in the app settings. Keep the private key here.
ORIGIN_APP_ID=
ORIGIN_APP_PRIVATE_KEY=
ORIGIN_APP_PRIVATE_KEY_FILE=
ORIGIN_API_BASE=https://api.cursor.com
ORIGIN_JWKS_URL=https://api.cursor.com/v1/origin/keys
